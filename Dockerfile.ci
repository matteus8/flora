# Use AWS Public ECR to avoid Docker Hub rate limits
FROM public.ecr.aws/docker/library/golang:1.23-alpine

ARG ZARF_VERSION=v0.67.0
ARG TARGETARCH=amd64

# 1. Install System Dependencies
# python3/py3-pip: For modelaudit (Job 1)
# aws-cli: For ECR login
# docker-cli: For dind interaction
# git/make/bash/curl: For scripts and Makefiles
RUN apk add --no-cache \
    curl \
    bash \
    git \
    make \
    docker-cli \
    aws-cli \
    python3 \
    py3-pip

# 2. Install Zarf
RUN curl -sL "https://github.com/zarf-dev/zarf/releases/download/${ZARF_VERSION}/zarf_${ZARF_VERSION}_Linux_${TARGETARCH}" \
    -o /usr/local/bin/zarf && \
    chmod +x /usr/local/bin/zarf

# 3. Install Python Dependencies (Pre-install modelaudit)
# We use --break-system-packages because Alpine manages python externally, 
# but for a CI image, this is acceptable.
RUN python3 -m pip install modelaudit --no-cache-dir --break-system-packages

# 4. Verify
RUN zarf version && aws --version && docker --version && go version && python3 --version

WORKDIR /app